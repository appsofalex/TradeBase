private struct CapsuleActionButton: View {
    var title: String
    var systemImage: String
    var tint: Color = TBTheme.brand
    var action: () -> Void

    var body: some View {
        Button(action: action) {
            Label(title, systemImage: systemImage)
                .font(.headline)
                .foregroundStyle(.white)
                .padding(.vertical, 12)
