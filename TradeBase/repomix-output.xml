                        Text(emptyStateLine)
                            .multilineTextAlignment(.center)
                            .foregroundStyle(.secondary)
                    }
                    .frame(maxWidth: .infinity)
                    .padding(.vertical, 40)
                }
                .refreshable {
                    await state.refreshProfileFromCloud()
                }
            } else {
                List {
                    Section {
                        ForEach(resolvedReviews) { r in
                            VStack(alignment: .leading, spacing: 8) {
                                HStack {
                                    Stars(rating: r.rating)
                                    Spacer()
